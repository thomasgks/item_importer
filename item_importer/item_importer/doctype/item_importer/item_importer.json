{
  "doctype": "DocType",
  "name": "Item Importer",
  "module": "Item Importer",
  "custom": 0,
  "istable": 0,
  "editable_grid": 0,
  "read_only": 0,
  "track_changes": 1,
  "route": "item-importer",
  "allow_rename": 0,
  "engine": "InnoDB",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "fields": [
    {
      "fieldname": "import_section",
      "fieldtype": "Section Break",
      "label": "Item Import"
    },
    {
      "fieldname": "import_file",
      "fieldtype": "Attach",
      "label": "Import File",
      "reqd": 0
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "\nPending\nIn Progress\nCompleted\nPartially Completed\nFailed",
      "default": "Pending",
      "read_only": 1
    },
    {
      "fieldname": "progress",
      "fieldtype": "Int",
      "label": "Progress (%)",
      "read_only": 1
    },
    {
      "fieldname": "last_log",
      "fieldtype": "Link",
      "label": "Last Log",
      "options": "Item Import Log",
      "read_only": 1
    },
    {
      "fieldname": "update_options_section",
      "fieldtype": "Section Break",
      "label": "Update Options for Existing Items"
    },
    {
      "fieldname": "custom_update_existing_items",
      "fieldtype": "Check",
      "label": "Update Existing Items",
      "default": "0"
    },
    {
      "fieldname": "custom_update_existing_prices",
      "fieldtype": "Check",
      "label": "Update Existing Prices",
      "default": "0"
    },
    {
      "fieldname": "custom_update_existing_barcodes",
      "fieldtype": "Select",
      "label": "Update Existing Barcodes",
      "options": "No Barcode Update\nReplace Existing Barcodes\nAdd Barcode to Existing List",
      "default": "No Barcode Update"
    },
    {
      "fieldname": "purchase_order_section",
      "fieldtype": "Section Break",
      "label": "Purchase Order"
    },
    {
      "fieldname": "create_purchase_order",
      "fieldtype": "Check",
      "label": "Create Purchase Order After Import",
      "default": "0"
    },
    {
      "fieldname": "rename_section",
      "fieldtype": "Section Break",
      "label": "Rename Template",
      "collapsible": 1
    },
    {
      "fieldname": "custom_select_file",
      "fieldtype": "Attach",
      "label": "Select File",
      "reqd": 0
    },
    {
      "fieldname": "custom_rename",
      "fieldtype": "Button",
      "label": "Rename"
    },
    {
      "fieldname": "custom_rename_log",
      "fieldtype": "Long Text",
      "label": "Rename Log",
      "read_only": 1,
      "depends_on": "eval:doc.custom_rename_log"
    }
  ]
}